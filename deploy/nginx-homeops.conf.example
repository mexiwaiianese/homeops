# Laravel Forge nginx snippet for a Next.js HomeOps site.
# Put this on the Forge site that should serve HomeOps (new site, not the Laravel app).
# Proxy to the Forge daemon that runs: node .next/standalone/server.js

# location / { ... } replacement:
location / {
    proxy_pass http://127.0.0.1:3010;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
}

location /_next/static/ {
    alias /home/forge/HOMEOPS_SITE_PATH/.next/static/;
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
}

location /brand/ {
    alias /home/forge/HOMEOPS_SITE_PATH/public/brand/;
    access_log off;
    expires 30d;
}
