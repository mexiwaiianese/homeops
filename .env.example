NEXT_PUBLIC_SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
# Legacy deployments may use NEXT_PUBLIC_SUPABASE_URL instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: set this to the public Forge hostname, e.g. https://homeops.YOUR_DOMAIN
# Do not point this at Vercel if you are deploying on Laravel Forge.

# Stripe rent collection. Server-only secret + webhook secret; publishable key is browser-safe.
# Leave blank to collect in demo mode (no real cards). Do not invent live keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Configure these as Edge Function secrets; never expose them with NEXT_PUBLIC_.
# Placeholder names only. Do not copy these example URLs into production.
CREDENTIAL_VERIFICATION_PROVIDER=provider-name
CREDENTIAL_VERIFICATION_URL=https://provider.example/verify
CREDENTIAL_VERIFICATION_TOKEN=YOUR_PROVIDER_TOKEN
MALWARE_SCANNER_URL=https://scanner.example/scan
MALWARE_SCANNER_TOKEN=YOUR_SCANNER_TOKEN

# Vendor recruitment. Server-only; never prefix with NEXT_PUBLIC_.
# Leave unset to use the local demo catalog instead of live Places lookups.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
VENDOR_OUTREACH_FROM_EMAIL=HomeOps <vendors@YOUR_DOMAIN>
RESEND_API_KEY=YOUR_RESEND_API_KEY
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Owner portal "ask for a number". Server-only. Any OpenAI-compatible chat endpoint works.
# Leave blank to use the built-in local interpreter (no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Owner Google/Apple sign-in is configured in Supabase Auth > Providers (no app env needed).
# Add {NEXT_PUBLIC_APP_URL}/auth/callback to the provider redirect URLs.

# Optional vendor service-calendar OAuth. Leave unset to use the demo connect button.
# Do not invent a production Google Calendar integration without this client id.
GOOGLE_CALENDAR_CLIENT_ID=

# Listing syndication. These networks do not offer a public self-serve post API.
# HomeOps hosts pull feeds; optional push URLs are only for approved partner endpoints.
# Leave push URLs blank until the ILS gives you one. Do not scrape their sites.
ZILLOW_RENTALS_PUSH_URL=
APARTMENTS_FEED_PUSH_URL=
RENT_FEED_PUSH_URL=
REALTOR_FEED_PUSH_URL=
ZUMPER_FEED_PUSH_URL=
